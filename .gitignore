# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get quite large, so it's negative code footprint to keep in git
/[Mm]emoryCaptures/

# AssetImportState can get quite large, so it's negative code footprint to keep in git
/[Aa]ssets/[Aa]sset[Ii]mport[Ss]tate/

# Exported iOS builds
/iOS/

# Plug-ins and vendor-specific folders
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/Plugins/Editor/Resharper*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.db
*.slnx

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage
*.bundle

# Crashlytics generated file
crashlytics-build.properties

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# JetBrains Rider
.idea/
*.sln.iml
